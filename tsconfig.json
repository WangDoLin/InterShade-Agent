{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noImplicitAny": true,
    "types": ["node"]
  },
  "include": [
    "cli/**/*",
    "config/**/*",
    "context/**/*",
    "engine/**/*",
    "gateway/**/*",
    "locales/**/*",
    "nn/**/*",
    "orchestrator/**/*",
    "providers/**/*",
    "scripts/**/*",
    "security/**/*",
    "state/**/*",
    "tools/**/*",
    "types/**/*",
    "ui/**/*",
    "services/**/*",
    "tasks/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
