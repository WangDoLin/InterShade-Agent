{
  "name": "intershader",
  "version": "1.0.0",
  "description": "InterShader CLI coding agent",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "intershader": "./dist/index.js",
    "intershade": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx cli/index.ts",
    "build": "tsup cli/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-tests.ts --tier=tier1",
    "test:tier1": "tsx scripts/run-tests.ts --tier=tier1",
    "test:tier2": "tsx scripts/run-tests.ts --tier=tier2",
    "test:all": "tsx scripts/run-tests.ts --tier=tier1,tier2",
    "test:live": "tsx scripts/run-tests.ts --tier=tier-live",
    "i18n:check": "tsx scripts/check-locales.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "claude-code",
    "hermes",
    "intershader",
    "tui",
    "cli"
  ],
  "author": "InterShader Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.0",
    "@modelcontextprotocol/sdk": "^1.6.1",

    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.3",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "openai": "^4.86.1",
    "react": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}